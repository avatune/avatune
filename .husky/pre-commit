#!/bin/sh

# Run lint-staged for format and lint checks
bunx lint-staged

# Type checking
echo "Running type checks..."
bun run check-types

# Check if generation scripts produce any changes
echo "Checking if generated files are up to date..."

bun run generate:root-readme
bun run generate:theme-readme

# The Swift package is generated from the themes' build output, so it is only
# regenerated when something it derives from actually changed. A docs-only
# commit should not require a full theme build.
if git diff --cached --name-only | grep -qE '^(packages/(assets|themes)/|packages/core/(utils|types)/|scripts/(generate-swift|lib/)|swift/)'; then
  echo "Regenerating Swift sources..."
  if ! bun run generate:swift; then
    echo ""
    echo "Error: generate:swift failed. Did you run 'bun run build' first?"
    exit 1
  fi
fi

if ! git diff --quiet; then
  echo ""
  echo "Error: Generated files are out of date!"
  echo "Please run the generation scripts and commit the changes:"
  echo "  bun run generate:root-readme"
  echo "  bun run generate:theme-readme"
  echo ""
  git diff --stat
  exit 1
fi

echo "All generated files are up to date."
