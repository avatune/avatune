---
import AvatarUsagePreview from '../docs/avatar-usage-preview.svelte'
---
<section class="mx-auto max-w-6xl space-y-16">
  <div class="space-y-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-pink-200">Advantages of Avatune</p>
    <h2 class="text-3xl font-semibold text-white sm:text-4xl">Built for modern web and mobile</h2>
  </div>

  <!-- First row: Image left, Text right -->
  <div class="grid gap-8 items-center md:grid-cols-2">
    <div class="order-1 md:order-1">
      <div class="aspect-video rounded-2xl border border-white/10 bg-linear-to-br from-pink-500/20 to-purple-500/20 shadow-lg shadow-pink-400/10 flex items-center justify-center p-8">
        <svg viewBox="0 0 233 140" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <!-- Server (left) -->
          <rect x="23" y="40" width="82" height="58" rx="5" fill="rgb(236, 72, 153)" fill-opacity="0.2" stroke="rgb(236, 72, 153)" stroke-width="1"/>
          <text x="64" y="55" font-family="Arial, sans-serif" font-size="8" fill="rgb(236, 72, 153)" text-anchor="middle" font-weight="bold">Server</text>
          <rect x="29" y="61" width="70" height="3" rx="1" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          <rect x="29" y="68" width="58" height="3" rx="1" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          <rect x="29" y="76" width="64" height="3" rx="1" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          <circle cx="40" cy="87" r="5" fill="rgb(236, 72, 153)" fill-opacity="0.4"/>
          <circle cx="55" cy="87" r="5" fill="rgb(236, 72, 153)" fill-opacity="0.4"/>
          <circle cx="70" cy="87" r="5" fill="rgb(236, 72, 153)" fill-opacity="0.4"/>
          
          <!-- Arrow -->
          <path d="M 110 70 L 134 70" stroke="rgb(236, 72, 153)" stroke-width="2" fill="none" marker-end="url(#arrowhead-pink)"/>
          
          <!-- Browser page (right) -->
          <rect x="145" y="29" width="64" height="82" rx="5" fill="rgb(148, 163, 184)" fill-opacity="0.1" stroke="rgb(148, 163, 184)" stroke-width="1"/>
          <!-- Browser bar -->
          <rect x="145" y="29" width="64" height="12" rx="5" fill="rgb(148, 163, 184)" fill-opacity="0.2"/>
          <circle cx="154" cy="35" r="2" fill="rgb(239, 68, 68)" fill-opacity="0.6"/>
          <circle cx="163" cy="35" r="2" fill="rgb(234, 179, 8)" fill-opacity="0.6"/>
          <circle cx="172" cy="35" r="2" fill="rgb(34, 197, 94)" fill-opacity="0.6"/>
          <!-- Page content -->
          <rect x="152" y="47" width="52" height="2" rx="1" fill="rgb(148, 163, 184)" fill-opacity="0.3"/>
          <rect x="152" y="54" width="40" height="2" rx="1" fill="rgb(148, 163, 184)" fill-opacity="0.3"/>
          <rect x="152" y="61" width="47" height="2" rx="1" fill="rgb(148, 163, 184)" fill-opacity="0.3"/>
          <!-- Avatar circles -->
          <circle cx="163" cy="75" r="8" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          <circle cx="180" cy="75" r="8" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          <circle cx="172" cy="90" r="8" fill="rgb(236, 72, 153)" fill-opacity="0.5"/>
          
          <!-- Arrow marker definition -->
          <defs>
            <marker id="arrowhead-pink" markerWidth="5" markerHeight="5" refX="4" refY="2" orient="auto">
              <polygon points="0 0, 5 2, 0 3" fill="rgb(236, 72, 153)"/>
            </marker>
          </defs>
        </svg>
      </div>
    </div>
    <div class="order-2 md:order-2 space-y-4">
      <h3 class="text-2xl font-semibold text-white">First-class SSR</h3>
      <p class="text-slate-300 leading-relaxed">
        Avatune renders instantly on the server with no image-loading delays. Your avatars appear immediately, perfect for SEO and lightning-fast page loads.
      </p>
    </div>
  </div>

  <!-- Second row: Image right, Text left -->
  <div class="grid gap-8 items-center md:grid-cols-2">
    <div class="order-2 md:order-1 space-y-4">
      <h3 class="text-2xl font-semibold text-white">Native on Mobile</h3>
      <p class="text-slate-300 leading-relaxed">
        Experience smooth performance and mobile-native rendering with Avatune. Full React Native support ensures your avatars look and feel native on every device.
      </p>
    </div>
    <div class="order-1 md:order-2">
      <div class="aspect-video rounded-2xl border border-white/10 bg-linear-to-br from-blue-500/20 to-cyan-500/20 shadow-lg shadow-blue-400/10 flex items-center justify-center p-8 relative">
        <svg viewBox="0 0 233 140" class="w-full h-full absolute inset-0" xmlns="http://www.w3.org/2000/svg">
          <!-- Mobile device frame -->
          <rect x="82" y="12" width="70" height="117" rx="12" fill="rgb(30, 41, 59)" stroke="rgb(148, 163, 184)" stroke-width="2"/>
          <rect x="87" y="17" width="58" height="105" rx="7" fill="rgb(15, 23, 42)"/>
          
          <!-- Screen content -->
          <rect x="93" y="23" width="47" height="7" rx="1" fill="rgb(59, 130, 246)" fill-opacity="0.3"/>
          <rect x="93" y="33" width="35" height="5" rx="1" fill="rgb(148, 163, 184)" fill-opacity="0.3"/>
          
          <!-- Home indicator -->
          <rect x="107" y="114" width="17" height="2" rx="1" fill="rgb(148, 163, 184)" fill-opacity="0.5"/>

          <!-- Performance indicator -->
          <circle cx="163" cy="70" r="14" fill="none" stroke="rgb(34, 211, 238)" stroke-width="1" stroke-dasharray="2 2"/>
          <path d="M 163 58 L 163 55 M 163 82 L 163 84 M 152 70 L 149 70 M 175 70 L 177 70" stroke="rgb(34, 211, 238)" stroke-width="1"/>
        </svg>
        <!-- Avatar inside phone screen -->
        <div class="absolute" style="left: 50%; top: 40%; transform: translate(-50%, -50%); width: 100px; height: 100px; margin-top: 10px;">
          <AvatarUsagePreview client:only="svelte" themeId="pacovqzz" seed="mobile" size={100} />
        </div>
      </div>
    </div>
  </div>

  <!-- Third row: Image left, Text right -->
  <div class="grid gap-8 items-center md:grid-cols-2">
    <div class="order-1 md:order-1">
      <div class="aspect-video rounded-2xl border border-white/10 bg-linear-to-br from-green-500/20 to-emerald-500/20 shadow-lg shadow-green-400/10 flex items-center justify-center p-8">
        <svg viewBox="0 0 233 140" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <!-- Root: Avatune -->
          <circle cx="117" cy="29" r="23" fill="rgb(34, 197, 94)" fill-opacity="0.7" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <text x="117" y="33" font-family="Arial, sans-serif" font-size="9" fill="white" text-anchor="middle" font-weight="bold">Avatune</text>
          
          <!-- themes -->
          <line x1="117" y1="52" x2="40" y2="82" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <rect x="12" y="82" width="58" height="21" rx="3" fill="rgb(34, 197, 94)" fill-opacity="0.7" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <text x="40" y="94" font-family="Arial, sans-serif" font-size="8" fill="white" text-anchor="middle" font-weight="bold">themes</text>
          
          <!-- assets -->
          <line x1="117" y1="52" x2="117" y2="93" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <rect x="87" y="93" width="58" height="21" rx="3" fill="rgb(34, 197, 94)" fill-opacity="0.7" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <text x="117" y="106" font-family="Arial, sans-serif" font-size="8" fill="white" text-anchor="middle" font-weight="bold">assets</text>
          
          <!-- renderers -->
          <line x1="117" y1="52" x2="192" y2="82" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <rect x="163" y="82" width="58" height="21" rx="3" fill="rgb(34, 197, 94)" fill-opacity="0.7" stroke="rgb(34, 197, 94)" stroke-width="2"/>
          <text x="192" y="94" font-family="Arial, sans-serif" font-size="8" fill="white" text-anchor="middle" font-weight="bold">renderers</text>
        </svg>
      </div>
    </div>
    <div class="order-2 md:order-2 space-y-4">
      <h3 class="text-2xl font-semibold text-white">Tree-shakable</h3>
      <p class="text-slate-300 leading-relaxed">
        Only used components are bundled, keeping Avatune lightweight and fast. Import exactly what you need and leave the rest behind.
      </p>
    </div>
  </div>
</section>

