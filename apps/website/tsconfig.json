{
  "extends": "@avatune/typescript-config/nextjs",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "source.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".source/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mdx"
  ],
  "exclude": ["node_modules", "out"]
}
